# Variáveis de produção (VPS). Copie para .env na pasta do projeto e preencha:
#   cp deploy/env.producao.exemplo .env && nano .env
# Nunca versione o .env. Guia completo em docs/IMPLANTACAO.md.
#
# Gere cada segredo com (só letras, números, "-" e "_", seguro para a URL do banco):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Chave das sessões (mínimo 32 caracteres; o app se recusa a subir com um valor de exemplo)
SECRET_KEY=GERE_UMA_CHAVE

# Banco de dados (fica só na rede interna do Docker, sem porta exposta)
POSTGRES_USER=tcc
POSTGRES_PASSWORD=GERE_UMA_SENHA
POSTGRES_DB=despesas

# Administrador inicial (a senha precisa ter pelo menos 12 caracteres)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_SENHA=TROQUE_POR_UMA_SENHA_FORTE

# 1 = carrega a base sintética (5.000 despesas) na primeira subida
SEED_BASE_SINTETICA=1

# Job de reprocessamento: intervalo em minutos (0 desliga)
REPROCESSAMENTO_INTERVALO_MIN=15

# Gunicorn: processos do app (3 é adequado para 2 GB de RAM) e porta local para o Nginx
GUNICORN_WORKERS=3
PORTA_APP=8000
