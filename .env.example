# Copie para .env e ajuste os valores:  cp .env.example .env
# Nunca faça commit do arquivo .env.

# --- Flask ---
FLASK_APP=wsgi.py
FLASK_DEBUG=1
# Gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# --- PostgreSQL (usado pelo docker-compose) ---
POSTGRES_USER=tcc
POSTGRES_PASSWORD=tcc
POSTGRES_DB=despesas
POSTGRES_PORT=5432

# URL de conexão da aplicação.
# Dentro do Docker Compose o host é "db"; rodando fora do Docker, use "localhost".
DATABASE_URL=postgresql+psycopg://tcc:tcc@localhost:5432/despesas

# Banco usado pelos testes que precisam de PostgreSQL (trigger, migrations).
# Se ficar vazio, esses testes são pulados e o restante roda em SQLite em memória.
TEST_DATABASE_URL=postgresql+psycopg://tcc:tcc@localhost:5432/despesas_teste

# --- Administrador inicial (criado por "flask seed-admin") ---
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=troque-esta-senha

# --- Base sintética ---
# Com 1, o container carrega a base sintética (seed 42) na subida, se ainda não estiver carregada.
SEED_BASE_SINTETICA=0
